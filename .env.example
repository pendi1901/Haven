AIRNOW_API_KEY=
PURPLEAIR_API_KEY=          # optional
FIRMS_MAP_KEY=
GEMINI_API_KEY=             # optional (rephrases verdicts; falls back to templates)
NWS_USER_AGENT="Haven (team-email@example.com)"   # NWS requires a User-Agent with contact info
DATA_MODE=live              # default mode when the app opens (users can switch in the header)
REGION=asheville            # prepared region to show when no location is known (and for `app.prepare`)

# Optional
CENSUS_API_KEY=             # adds ACS age 65+ / no-vehicle households to the responder view
NCDOT_EVENTS_URL=           # DriveNC events endpoint (live closures); unset = closures disabled
NCDOT_API_KEY=
WARM_REPLAY_CACHE=true      # precompute all replay timesteps at startup so the slider scrubs instantly
